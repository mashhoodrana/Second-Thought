# ─────────────────────────────────────────────────────────────────
# Backend environment — NEVER commit this file
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# === PUBLIC CONFIGURATION VALUES ===

# Supabase URL (from Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (safe for client/server, used for auth verification)
SUPABASE_ANON_KEY=your-anon-key-here

# Application Environment (development, production, test)
APP_ENV=development

# CORS: Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000

# Gemini model settings (optional, defaults are used if not specified)
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash


# === SERVER-ONLY SECRETS ===

# Google Gemini API key (required for parallel AI lenses and claim processing)
GEMINI_API_KEY=your-gemini-api-key-here

# Tavily Search API key (required for evidence search lens)
SEARCH_API_KEY=your-tavily-search-key-here
